{
  "name": "fami-weight-record",
  "version": "2.18.1",
  "description": "家與毛孩成長誌 (Kin & Paws) — 溫潤文青風格的家庭與毛孩體重及身高成長紀錄前端",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./www/styles.css --minify",
    "build:vendor": "node -e \"const fs=require('fs');fs.mkdirSync('www/vendor',{recursive:true});fs.copyFileSync('node_modules/chart.js/dist/chart.umd.min.js','www/vendor/chart.umd.min.js');\"",
    "build:selfhost": "node scripts/build-edition.mjs --edition=selfhost",
    "build:store": "node scripts/build-edition.mjs --edition=store",
    "build": "npm run build:selfhost",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "chart.js": "^4.6.2",
    "tailwindcss": "^3.4.19"
  }
}
